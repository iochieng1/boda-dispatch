# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to open a socket (the web app).
CORS_ORIGINS=http://localhost:3000

# Matches docker-compose.yml
DATABASE_URL=postgres://boda:boda@localhost:5432/boda_dispatch
REDIS_URL=redis://localhost:6379

# Signs dispatcher access tokens. 32+ characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
